# Strada — environment variables.
#
# Copy to .env.local and fill in real values. .env.local is gitignored; only this
# example file is committed, and it contains placeholders only.
#
# The split below is the whole secret-handling story:
#   - PUBLIC values are inlined into the browser bundle and are safe there. They are
#     not credentials: the Neon Auth URL is an endpoint anyone can call, and holding it
#     grants nothing without a valid signed session.
#   - SERVER-ONLY values are set in the API's Vercel project and never in the web one.
#   - DATABASE_URL is neither. It is a local tool credential used by migrations and is
#     never added to any Vercel project.


# ---------------------------------------------------------------------------
# PUBLIC — apps/web (Vercel project A)
# ---------------------------------------------------------------------------
# Vite exposes only variables matching envPrefix (["VITE_", "NEXT_PUBLIC_"]), so
# nothing below this file's SERVER-ONLY section can reach the bundle even by mistake.

NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-123456.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Note: NEXT_PUBLIC_NEON_DATA_API_URL is deliberately NOT set. The browser never talks
# to the Data API directly — every read and write goes through apps/api — so shipping
# the endpoint to the client would widen the surface for no benefit.


# ---------------------------------------------------------------------------
# SERVER-ONLY — apps/api (Vercel project B)
# ---------------------------------------------------------------------------

NEON_AUTH_BASE_URL=https://ep-example-123456.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_DATA_API_URL=https://ep-example-123456.us-east-1.aws.neon.tech/neondb/rest/v1

# Comma-separated browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173

# Optional JWT claim pinning. Set these only after decoding a real token and confirming
# the claims are present — pinning a claim the issuer does not send rejects every valid
# token. See README "Authentication and ownership".
# NEON_AUTH_ISSUER=
# NEON_AUTH_AUDIENCE=

PORT=3001


# ---------------------------------------------------------------------------
# LOCAL TOOLING ONLY — never added to Vercel
# ---------------------------------------------------------------------------
# Used by `npm run migrate` to apply db/migrations/*.sql. The deployed API has no
# Postgres driver and no connection string; it reaches the database only through the
# Data API carrying the end user's own JWT, so RLS applies to every query it makes.
# `npm test` asserts that no file under apps/api/src references this variable.

DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require

# NEON_AUTH_COOKIE_SECRET is not used by this implementation: the SPA holds a bearer
# token and there is no server-side cookie session to sign.
